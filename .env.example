# --- Provedor OpenAI-compat (Qwen local) -------------------------------------
LLM_API_BASE=http://localhost:8001/v1
LLM_API_KEY=sk-llama-local
LLM_MODEL=Qwen3.6
LLM_USE_SYSTEM_ROLE=true

# --- SearXNG ------------------------------------------------------------------
# Sua instância em docker
SEARXNG_URL=http://localhost:8888
SEARXNG_MAX_RESULTS=5
SEARXNG_LANGUAGE=pt-BR
SEARXNG_TIMEOUT=15

# --- Geolocalização por IP ----------------------------------------------------
IPAPI_URL=http://ip-api.com/json/?fields=status,message,country,regionName,city,lat,lon,timezone,query

# --- Comportamento do agente --------------------------------------------------
AGENT_NAME=Aurora
AGENT_MAX_TOOL_CALLS=10
AGENT_THINKING_EFFORT=medium
AGENT_THINKING_TIMEOUT=90          # aborta se só-thinking por X segundos
AGENT_TURN_TIMEOUT=300             # cap total de X segundos por turno
AGENT_TEMPERATURE=0.7

# --- Memória / Banco SQLite ---------------------------------------------------
DB_PATH=./data/aurora.db
COMPACTION_THRESHOLD=30           # dispara auto-compactação a cada N msgs
COMPACTION_KEEP_HEAD=5            # quantas msgs do início manter antes do resumo
COMPACTION_KEEP_TAIL=5            # quantas msgs do final manter depois do resumo
SESSION_HISTORY_ON_BOOT=10        # msgs injetadas no system prompt ao /carregar

# --- Pastas -------------------------------------------------------------------
DATA_DIR=./data
LOG_DIR=./logs
