# OBRIGATÓRIO — segredo usado pelo SearXNG pra assinar cookies/limiter.
# Gere um novo com:  openssl rand -hex 32
SEARXNG_SECRET=troque-isso-por-um-valor-aleatorio-de-pelo-menos-32-chars

# Opcional — onde o container escuta de fora
SEARXNG_BIND_ADDR=0.0.0.0
SEARXNG_PORT_HOST=8888

# Opcional — porta interna do container (NÃO mude a menos que saiba o que faz)
# SEARXNG_PORT_CONTAINER=8080
